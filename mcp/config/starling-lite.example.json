{
  "mcpServers": {
    "warble-army": {
      "command": "/path/to/warble-army/bin/starling-lite",
      "args": [
        "--mode=readonly",
        "--transport=stdio",
        "--registry",
        "/path/to/warble-army/mcp/tools/registry.json"
      ],
      "env": {
        "KUBECONFIG": "${HOME}/.kube/config"
      }
    }
  },
  "_comment": "Build with: make starling-lite  (from warble-army root)"
}
